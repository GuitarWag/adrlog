# Build output.
.claude/bin/

# Per-worktree nudge state. Never shared, never committed.
.adrlog/state/

# Journals are a per-repo choice. adrlog's own repo does not commit them;
# `adrlog journal --export <session>` shares one when it is worth sharing.
.adrlog/journal/

# Codex agent definitions, machine-local.
.codex/
