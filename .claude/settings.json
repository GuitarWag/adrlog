{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" ] || { echo 'dlog binary missing, run make install; decision tracking is off'; exit 0; }; exec \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" hook session-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" hook subagent-stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" hook stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" hook pre-compact"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR/.claude/bin/dlog\" hook post-tool-use"
          }
        ]
      }
    ]
  }
}
